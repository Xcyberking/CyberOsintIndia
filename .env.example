# Copy this file to .env.local for local development.
# Firebase Console -> Project settings -> General -> Your apps -> Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin SDK credentials. Project ID must match service-account project_id.
FIREBASE_PROJECT_ID=
# Paste the complete downloaded service-account JSON on ONE line. Never expose or commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Supabase project used for Tools, Site Settings and image uploads.\n# Project URL may be left at the default configured in lib/supabase/rest.ts.\nSUPABASE_URL=https://pwwwoppmhefscguajzwc.supabase.co\n# Server-only Supabase service role / secret key. Never use NEXT_PUBLIC_ for this key.\nSUPABASE_SERVICE_ROLE_KEY=\n\n# Local one-time setup only: email of the verified account to make administrator.
ADMIN_EMAIL=
