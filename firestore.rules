rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.wallet_balance == 0
        && request.resource.data.credits == 0;
      allow update: if admin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.credits == resource.data.credits
        && request.resource.data.wallet_balance == resource.data.wallet_balance);
      allow delete: if admin();
    }
    match /{collection}/{docId} {
      allow read: if admin() || (signedIn() && resource.data.user_id == request.auth.uid)
        || (collection in ['tools','premium_plans','site_settings','announcements'] && resource.data.enabled != false && resource.data.is_active != false && resource.data.active != false);
      allow create, update, delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
