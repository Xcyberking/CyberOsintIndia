rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.wallet_balance == 0
        && request.resource.data.credits == 0;
      allow update: if admin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.credits == resource.data.credits
        && request.resource.data.wallet_balance == resource.data.wallet_balance);
      allow delete: if admin();
    }
    match /tools/{id} { allow read: if signedIn() && (admin() || resource.data.enabled == true); allow write: if admin(); }
    match /premium_plans/{id} { allow read: if signedIn() && (admin() || resource.data.is_active == true); allow write: if admin(); }
    match /site_settings/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /announcements/{id} { allow read: if signedIn() && (admin() || resource.data.active == true); allow write: if admin(); }
    match /search_history/{id} { allow read, delete: if signedIn() && (admin() || resource.data.user_id == request.auth.uid); allow create: if signedIn() && request.resource.data.user_id == request.auth.uid; allow update: if false; }
    match /payment_records/{id} { allow read: if signedIn() && (admin() || resource.data.user_id == request.auth.uid); allow create: if signedIn() && request.resource.data.user_id == request.auth.uid && request.resource.data.status == 'pending'; allow update, delete: if admin(); }
    match /wallet_transactions/{id} { allow read: if signedIn() && (admin() || resource.data.user_id == request.auth.uid); allow write: if admin(); }
    match /credit_transactions/{id} { allow read: if signedIn() && (admin() || resource.data.user_id == request.auth.uid); allow write: if admin(); }
    match /referral_claims/{id} { allow read: if signedIn() && (admin() || resource.data.referrer_id == request.auth.uid || resource.data.referred_id == request.auth.uid); allow write: if admin(); }
    match /support_tickets/{id} { allow read: if signedIn() && (admin() || resource.data.user_id == request.auth.uid); allow create: if signedIn() && request.resource.data.user_id == request.auth.uid; allow update, delete: if admin(); }
    match /{collection}/{id} { allow read, write: if admin(); }
  }
}
